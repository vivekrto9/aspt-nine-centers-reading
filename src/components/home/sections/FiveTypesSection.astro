---
import { TYPES } from "../../../data/human-design.constants.ts";

const TYPE_IMAGE_BASE =
  "https://astro-vedicrishi-in.b-cdn.net/human-design/body-type-compatibility/cards";

const {
  eyebrow = "02 · The five types",
  title = "Everybody is one of five",
  hint = "Select one to read its strategy.",
  eyebrowEdit = {},
  titleEdit = {},
  hintEdit = {},
} = Astro.props;
---

<section id="types" class="five-types-section" data-five-types-section>
  <div class="types-heading">
    <div>
      <p class="section-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
      <h2 class="section-heading" {...titleEdit}>{title}</h2>
    </div>
    <p class="section-hint" {...hintEdit}>{hint}</p>
  </div>

  <div class="type-tabs" role="tablist" aria-label="Human Design types">
    {TYPES.map((type, index) => (
      <button
        type="button"
        class:list={["type-tab", { "is-active": index === 1 }]}
        role="tab"
        id={`type-tab-${index}`}
        aria-controls={`type-panel-${index}`}
        aria-selected={index === 1 ? "true" : "false"}
        tabindex={index === 1 ? 0 : -1}
        data-type-tab={index}
      >
        {type.name}
      </button>
    ))}
  </div>

  <div class="type-panels">
    {TYPES.map((type, index) => (
      <article
        class="type-panel"
        role="tabpanel"
        id={`type-panel-${index}`}
        aria-labelledby={`type-tab-${index}`}
        data-type-panel={index}
        hidden={index !== 1}
      >
        <div class="type-visual">
          <img
            src={`${TYPE_IMAGE_BASE}/${type.id}.png`}
            alt={`${type.name} Human Design type`}
            width="1572"
            height="1572"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="type-copy">
          <p class="type-share">{type.share} of people</p>
          <h3>{type.name}</h3>
          <p>{type.body}</p>
        </div>
        <dl class="type-specs">
          <div><dt>Strategy</dt><dd>{type.strategy}</dd></div>
          <div><dt>Signature — it is working</dt><dd>{type.signature}</dd></div>
          <div><dt>Not-self — it is not</dt><dd>{type.notSelf}</dd></div>
        </dl>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-five-types-section]");
    if (!section) return;
    const tabs = Array.from(section.querySelectorAll("[data-type-tab]"));
    const panels = Array.from(section.querySelectorAll("[data-type-panel]"));

    const activate = (index) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.classList.toggle("is-active", selected);
        tab.setAttribute("aria-selected", String(selected));
        tab.setAttribute("tabindex", selected ? "0" : "-1");
      });
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0
          : event.key === "End" ? tabs.length - 1
          : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        activate(next);
        tabs[next]?.focus();
      });
    });
  })();
</script>

<style>
  .five-types-section {
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 86px 32px;
    background: #FFFFFF;
    color: var(--color-ink);
  }
  .types-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 44px;
  }
  .section-eyebrow {
    margin: 0 0 20px;
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .17em;
    text-transform: uppercase;
  }
  .section-heading {
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -.015em;
  }
  .section-hint {
    max-width: 30ch;
    margin: 0;
    color: var(--color-soft-blue);
    font-size: 15.5px;
    line-height: 1.6;
  }
  .type-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 34px; }
  .type-tab {
    padding: 11px 18px;
    border: 1px solid #DEDDD6;
    border-radius: 2px;
    background: #FFFFFF;
    color: var(--color-text-dark);
    font-size: 14.5px;
    cursor: pointer;
  }
  .type-tab.is-active { border-color: var(--color-accent); background: var(--color-accent); color: #FFFFFF; }
  .type-tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .type-panel {
    display: grid;
    grid-template-columns: minmax(0, .62fr) minmax(0, 1fr) minmax(0, .85fr);
    gap: 1px;
    padding: 1px;
    background: var(--color-subtle-border);
  }
  .type-panel[hidden] { display: none; }
  .type-visual, .type-copy, .type-specs { background: #FFFFFF; }
  .type-visual {
    position: relative;
    width: calc(100% - 26px);
    min-width: 0;
    min-height: 320px;
    margin: 13px;
    background-color: #F4F3EF;
    overflow: hidden;
  }
  .type-visual img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .type-copy { padding: 40px 38px; }
  .type-share { margin: 0 0 14px !important; color: var(--color-accent) !important; font-size: 11px !important; letter-spacing: .12em; }
  .type-copy h3 { margin: 0 0 18px; font-family: var(--font-display); font-size: 32px; font-weight: 400; line-height: 1.16; }
  .type-copy > p:last-child { margin: 0; color: var(--color-text-dark); font-size: 16.5px; line-height: 1.68; text-wrap: pretty; }
  .type-specs { margin: 0; padding: 40px 38px; display: grid; gap: 26px; align-content: start; background: var(--color-cream); }
  .type-specs div { display: grid; gap: 8px; }
  .type-specs dt { color: var(--color-muted); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; }
  .type-specs dd { margin: 0; font-size: 16px; line-height: 1.6; }
  @media (max-width: 850px) {
    .type-panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .type-visual { grid-row: span 2; }
  }
  @media (max-width: 640px) {
    .five-types-section { padding: 64px 20px; }
    .section-heading { font-size: 34px; }
    .type-tabs { display: grid; grid-template-columns: 1fr 1fr; }
    .type-tab { padding-inline: 12px; }
    .type-panel { grid-template-columns: 1fr; }
    .type-visual { grid-row: auto; min-height: 220px; }
    .type-copy, .type-specs { padding: 28px 24px; }
  }
</style>
