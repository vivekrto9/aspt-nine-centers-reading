---
import { HOW_IT_RUNS } from "../../../data/human-design.constants.ts";

const { eyebrow = "How it runs", title = "Four steps, no homework", eyebrowEdit = {}, titleEdit = {} } = Astro.props;
---

<section class="how-it-runs-section" data-how-it-runs-section>
  <div class="section-header-grid">
    <span class="section-number">04</span>
    <div class="section-title-wrap">
      <p class="section-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
      <h2 class="section-heading" {...titleEdit}>{title}</h2>
    </div>
  </div>

  <div class="steps-grid">
    {HOW_IT_RUNS.map((s) => (
      <div class="step-card">
        <span class={`step-marker ${s.accent ? 'accent-marker' : 'cobalt-marker'}`}></span>
        <p class="step-num">{s.step}</p>
        <h3 class="step-title">{s.title}</h3>
        <p class="step-body">{s.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .how-it-runs-section {
    padding: 104px 32px 0;
  }

  .section-header-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: end;
    margin-bottom: 52px;
  }

  .section-number {
    grid-column: 1 / span 2;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 96px;
    line-height: 0.72;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px #0B3D2E;
  }

  .section-title-wrap {
    grid-column: 4 / span 7;
  }

  .section-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #5C2B2E;
    margin: 0 0 12px;
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1.5px solid #FBFBF9;
  }

  .step-card {
    padding: 26px 26px 0 26px;
    border-right: 1px solid rgba(74, 62, 54, 0.2);
  }

  .step-card:first-child {
    padding-left: 0;
  }

  .step-card:last-child {
    border-right: none;
    padding-right: 0;
  }

  .step-marker {
    width: 13px;
    height: 13px;
    display: block;
    margin: -33px 0 26px;
  }

  .accent-marker {
    background: #5C2B2E;
  }

  .cobalt-marker {
    background: #0B3D2E;
  }

  .step-num {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8B8E86;
    margin: 0 0 12px;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin: 0 0 8px;
  }

  .step-body {
    font-size: 15.5px;
    line-height: 1.58;
    color: #6E6157;
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .section-header-grid {
      grid-template-columns: 1fr;
    }
    .section-number, .section-title-wrap {
      grid-column: span 1;
    }
    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
    .step-card {
      padding: 24px;
      border-bottom: 1px solid rgba(74, 62, 54, 0.2);
    }
  }

  @media (max-width: 600px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
    .step-card {
      padding: 24px 0;
      border-right: none;
    }
  }

  /* Reading Almanac theme */
  .how-it-runs-section { background: #FBFBF9; color: #17191A; }
  .section-number { -webkit-text-stroke-color: #0B3D2E; }
  .steps-grid { border-top-color: #D8D7D0; }
  .step-card { border-color: #E8E7E1; }
  .step-title { color: #17191A; }
  .step-body { color: #8B8E86; }
  .accent-marker { background: #5C2B2E; }
  .cobalt-marker { background: #0B3D2E; }
</style>
