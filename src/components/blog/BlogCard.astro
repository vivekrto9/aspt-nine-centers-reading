---
import type { BlogArticle } from "../../data/blog-articles.ts";
import { getLocaleFromUrl, localizePath } from "../../data/localization-contract.ts";

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;
const locale = getLocaleFromUrl(Astro.request.url);
---

<article class="blog-article-card" data-article-slug={article.slug}>
  <a href={localizePath(`/blog/${article.slug}`, locale)} class="card-inner-link">
    <div class="card-thumb">
      <span class="card-tag">{article.tag}</span>
    </div>
    <div class="card-body">
      <div class="card-meta">
        <span class="card-date">{article.date}</span>
        <span class="card-author">&middot; {article.author}</span>
      </div>
      <h2 class="card-title">{article.title}</h2>
      <p class="card-excerpt">{article.excerpt}</p>
      <div class="card-footer">
        <span class="read-more-btn">Read guide &rarr;</span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-article-card {
    display: flex;
    flex-direction: column;
    border: 0;
    background: transparent;
    transition: transform .18s ease;
  }

  .blog-article-card:hover {
    transform: translateY(-3px);
  }

  .card-inner-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card-thumb {
    aspect-ratio: 16 / 9;
    background:
      linear-gradient(135deg, transparent 0 49.6%, #E8E7E1 49.7% 50.3%, transparent 50.4%),
      linear-gradient(45deg, transparent 0 49.6%, #E8E7E1 49.7% 50.3%, transparent 50.4%),
      #F4F3EF;
    background-size: 92px 92px;
    border: 1px solid var(--color-subtle-border);
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }

  .card-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .card-body {
    padding: 20px 0 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    font-size: 12px;
    color: #8B8E86;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -.015em;
    margin: 0 0 12px;
  }

  .card-excerpt {
    font-size: 14.5px;
    line-height: 1.48;
    color: var(--color-text-dark);
    margin: 0 0 24px;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    border-top: 1px solid #E8E7E1;
    padding-top: 14px;
  }

  .read-more-btn {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .blog-article-card:hover .read-more-btn {
    color: var(--color-ink);
  }
</style>
