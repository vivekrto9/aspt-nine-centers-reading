---
import type { BlogArticle } from "../../data/blog-articles.ts";
import { getLocaleFromUrl, localizePath } from "../../data/localization-contract.ts";

interface Props {
  articles: BlogArticle[];
}

const { articles } = Astro.props;
const locale = getLocaleFromUrl(Astro.request.url);
---

<section class="related-section" data-blog-related-articles>
  <div class="related-header">
    <p class="related-eyebrow">CONTINUE READING</p>
    <h2 class="related-title">Related guides & articles</h2>
  </div>
  <div class="related-grid">
    {articles.map((rel) => (
      <a href={localizePath(`/blog/${rel.slug}`, locale)} class="related-card">
        <div class="related-thumb">
          <span class="related-tag">{rel.tag}</span>
        </div>
        <h3 class="related-card-title">{rel.title}</h3>
      </a>
    ))}
  </div>
</section>

<style>
  .related-section {
    border-top: 1px solid var(--color-subtle-border);
    padding-top: 64px;
  }

  .related-header {
    margin-bottom: 36px;
  }

  .related-eyebrow {
    font-size: 10.5px;
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 8px;
  }

  .related-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -.015em;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    border: 0;
    background: transparent;
    text-decoration: none;
    color: inherit;
    transition: transform .18s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
  }

  .related-thumb {
    aspect-ratio: 16 / 9;
    background-color: #F4F3EF;
    background-image: repeating-linear-gradient(135deg, #E8E7E1 0 1px, transparent 1px 9px);
    border: 1px solid var(--color-subtle-border);
    padding: 14px;
    display: flex;
    align-items: flex-end;
  }

  .related-tag {
    font-size: 9.5px;
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .related-card-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -.015em;
    margin: 0;
    padding: 18px 0 0;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
