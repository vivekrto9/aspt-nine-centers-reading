---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  typesHref?: string;
  readingsHref?: string;
  questionsHref?: string;
  chartHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#foundations",
  typesHref = "#types",
  readingsHref = "#readings",
  questionsHref = "#faq",
  chartHref = "#chart",
} = Astro.props;
---

<header class="hd-header" data-hd-header>
  <a href={homeHref} class="brand-link" data-brand-link {...brandEdit}>
    <span class="brand-mark" aria-hidden="true">IX</span>
    <span>{brandName}</span>
  </a>
  <nav class="nav-links" aria-label="Primary Navigation">
    <a href={plateHref} class="nav-link">Foundations</a>
    <a href={typesHref} class="nav-link">Types</a>
    <a href={readingsHref} class="nav-link">Readings</a>
    <a href={questionsHref} class="nav-link">FAQ</a>
  </nav>
  <a href={chartHref} class="cta-btn" data-cta-btn>
    <span class="cta-label">Generate your chart</span>
    <span class="cta-arrow" aria-hidden="true">↗</span>
  </a>
</header>

<style>
  .hd-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    min-height: 72px;
    background: rgba(251, 251, 249, .93);
    color: var(--color-ink);
    backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 0 clamp(20px, 4vw, 56px);
    border-bottom: 1px solid var(--color-subtle-border);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -.01em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 38px);
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -.01em;
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color .2s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 17px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  .cta-btn:hover { background: var(--color-ink); color: #FFFFFF; }
  .cta-arrow { font-size: 14px; transition: transform .2s ease; }
  .cta-btn:hover .cta-arrow { transform: translate(2px, -2px); }

  .hd-header a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .hd-header {
      min-height: 64px;
      padding: 10px 18px;
    }
    .brand-link { font-size: 14px; }
    .brand-mark { width: 30px; height: 30px; }
    .nav-links { display: none; }
    .cta-btn { min-height: 38px; padding: 0 12px; }
    .cta-label { font-size: 11px; }
    .cta-arrow { display: none; }
  }
</style>
