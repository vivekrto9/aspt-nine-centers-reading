---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  typesHref?: string;
  readingsHref?: string;
  questionsHref?: string;
  chartHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#foundations",
  typesHref = "#types",
  readingsHref = "#readings",
  questionsHref = "#faq",
  chartHref = "#chart",
} = Astro.props;
---

<header class="hd-header" data-hd-header>
  <div class="header-inner">
    <a href={homeHref} class="brand-link" data-brand-link {...brandEdit}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{brandName}</span>
    </a>
    <nav class="nav-links" aria-label="Primary Navigation">
      <a href={plateHref} class="nav-link">Foundations</a>
      <a href={typesHref} class="nav-link">The five types</a>
      <a href={readingsHref} class="nav-link">Readings</a>
      <a href={questionsHref} class="nav-link">FAQ</a>
    </nav>
    <a href={chartHref} class="cta-btn" data-cta-btn>
      <span class="cta-label">Free chart</span>
    </a>
  </div>
</header>

<style>
  .hd-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgba(255, 255, 255, .93);
    color: var(--color-ink);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-subtle-border);
  }

  .header-inner {
    width: min(100%, 1180px);
    height: 68px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 19px;
    letter-spacing: -.01em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--color-accent);
    transform: rotate(45deg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color .2s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 18px;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  .cta-btn:hover { background: var(--color-ink); border-color: var(--color-ink); color: #FFFFFF; }

  .hd-header a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .hd-header {
      min-height: 64px;
    }
    .header-inner { height: 64px; padding: 0 18px; }
    .brand-link { font-size: 14px; }
    .brand-mark { width: 10px; height: 10px; }
    .nav-links { display: none; }
    .cta-btn { min-height: 38px; padding: 0 12px; }
    .cta-label { font-size: 11px; }
    .cta-arrow { display: none; }
  }
</style>
