---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import BlogArticlesGrid from "../components/blog/BlogArticlesGrid.astro";
import { BLOG_ARTICLES } from "../data/blog-articles.ts";
import { getLocaleFromUrl, localizePath } from "../data/localization-contract.ts";

export const prerender = false;
const locale = getLocaleFromUrl(Astro.request.url);
const homeHref = localizePath("/", locale);

const seoContent = {
  seo_title: "Human Design Writing & Field Notes — Nine Centres",
  seo_description: "Deep-dive guides on the 9 centres, strategy, authorities, energy types, and practical deconditioning.",
  seo_canonical_path: "/blog",
  seo_robots: "index,follow",
  og_title: "Human Design Writing & Field Notes — Nine Centres",
  og_description: "Explore essays on human design mechanics, defined and open centres, and real-world experiments.",
  og_image: "/_assets/aliases/logo/logo.svg",
  og_image_alt: "Nine Centres Human Design Diagram",
  twitter_card: "summary_large_image",
  twitter_title: "Human Design Writing — Nine Centres",
  twitter_description: "Practical guides and deconditioning field notes for Human Design.",
  twitter_image: "/_assets/aliases/logo/logo.svg",
};
---

<BaseLayout
  seo={seoContent}
  title="Human Design Writing & Field Notes — Nine Centres"
>
  <div class="site-wrap">
    <Header brandName="Nine Centres" homeHref={homeHref} plateHref={`${homeHref}#plate`} typesHref={`${homeHref}#types`} readingsHref={`${homeHref}#readings`} questionsHref={`${homeHref}#faq`} chartHref={localizePath("/human-design", locale)} />

    <main class="blog-main-content">
      <!-- Blog Hero Section -->
      <section class="blog-hero">
        <div class="blog-hero-top">
          <a href={homeHref} class="back-home-link">&larr; Back to home</a>
          <p class="blog-eyebrow">FIELD NOTES &middot; PLAIN LANGUAGE</p>
        </div>
        <h1 class="blog-hero-title">
          Reading the chart <span class="accent-text">yourself.</span>
        </h1>
        <p class="blog-hero-lead">
          Essays on human design mechanics, the wisdom of open centres, practical deconditioning protocols, and real-world strategy experiments.
        </p>
      </section>

      <!-- Articles Grid Section composed of common component -->
      <section class="blog-grid-section">
        <BlogArticlesGrid articles={BLOG_ARTICLES} />
      </section>
    </main>

    <Footer brandName="Nine Centres" homeHref={homeHref} plateHref={`${homeHref}#foundations`} readingsHref={`${homeHref}#readings`} questionsHref={`${homeHref}#faq`} />
  </div>
</BaseLayout>

<style>
  .site-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    color: var(--color-ink);
  }

  .blog-main-content {
    flex: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 86px 32px 112px;
  }

  .blog-hero {
    border-bottom: 1px solid var(--color-subtle-border);
    padding-bottom: 56px;
    margin-bottom: 56px;
  }

  .blog-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 42px;
  }

  .back-home-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-home-link:hover {
    color: var(--color-ink);
  }

  .blog-eyebrow {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .blog-hero-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.025em;
    margin: 0 0 30px;
    max-width: 16ch;
    text-wrap: balance;
  }

  .accent-text {
    color: var(--color-accent);
    font-family: inherit;
    font-weight: 400;
    font-style: normal;
    letter-spacing: inherit;
  }

  .blog-hero-lead {
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.65;
    color: var(--color-text-dark);
    max-width: 760px;
    margin: 0;
  }

  @media (max-width: 640px) {
    .blog-main-content {
      padding: 52px 20px 80px;
    }

    .blog-hero-top {
      align-items: flex-start;
      flex-direction: column;
      margin-bottom: 40px;
    }

    .blog-hero {
      margin-bottom: 48px;
      padding-bottom: 48px;
    }
  }
</style>
