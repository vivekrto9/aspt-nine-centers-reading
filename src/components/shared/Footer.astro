---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  readingsHref?: string;
  questionsHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#foundations",
  readingsHref = "#readings",
  questionsHref = "#faq",
} = Astro.props;
---

<footer class="hd-footer" data-hd-footer>
  <div class="footer-inner">
    <a href={homeHref} class="footer-brand" {...brandEdit}>
      <span class="footer-mark" aria-hidden="true"></span>
      <span>{brandName}</span>
    </a>
    <nav class="footer-nav" aria-label="Footer Navigation">
      <a href={plateHref} class="footer-link">Foundations</a>
      <a href={readingsHref} class="footer-link">Readings</a>
      <a href={questionsHref} class="footer-link">FAQ</a>
      <a href="#" class="footer-link">Privacy</a>
      <a href="#" class="footer-link">Contact</a>
    </nav>
    <p class="footer-copyright">&copy; 2026 &middot; Astropages template</p>
  </div>
</footer>

<style>
  .hd-footer {
    background: #17191A;
    color: #8B8E86;
    padding: 0;
    border-top: 1px solid #2A2C2D;
  }

  .footer-inner {
    max-width: 1180px;
    min-height: 112px;
    margin: 0 auto;
    padding: 44px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #E9E8E2;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
  }

  .footer-mark {
    width: 9px;
    height: 9px;
    border: 1.5px solid #6E7169;
    transform: rotate(45deg);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
  }

  .footer-link {
    font-size: 13.5px;
    font-weight: 400;
    color: #8B8E86;
    text-decoration: none;
    transition: color .2s ease;
  }

  .footer-link:hover {
    color: #FFFFFF;
  }

  .footer-copyright {
    margin: 0;
    color: #6E7169;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .08em;
  }

  @media (max-width: 640px) {
    .hd-footer {
      padding: 0;
    }
    .footer-inner { align-items: flex-start; padding: 40px 20px; flex-direction: column; }
    .footer-nav { justify-content: flex-start; }
  }
</style>
